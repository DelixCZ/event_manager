<% content_for :title, "#{@event.title} — Event Manager" %>

<article class="card event-detail">
  <section class="page-header">
    <div>
      <p class="eyebrow"><%= link_to "Organized by #{@event.organizer.name}", @event.organizer %></p>
      <h1><%= @event.title %></h1>
      <p class="meta">
        <%= date_range(@event) %>
        <% if @event.location.present? %>
          · <%= @event.location %>
        <% end %>
      </p>
      <p class="meta <%= "seat-status--full" if @event.full? %>"><%= seat_availability(@event) %></p>
    </div>
    <div class="button-row">
      <%= link_to "Edit", edit_event_path(@event), class: "button button--ghost" %>
      <%= button_to "Delete", @event, method: :delete, class: "button button--danger",
            data: { turbo_confirm: "Delete this event and its registrations?" } %>
    </div>
  </section>

  <% if @event.description.present? %>
    <p class="description"><%= @event.description %></p>
  <% end %>
</article>

<section class="card attendees-section">
  <h2>Confirmed <span class="count"><%= @confirmed_enrollments.size %> / <%= @event.capacity %></span></h2>

  <% if @confirmed_enrollments.any? %>
    <ul class="attendee-list">
      <% @confirmed_enrollments.each do |enrollment| %>
        <%= render "enrollments/enrollment", event: @event, enrollment: enrollment %>
      <% end %>
    </ul>
  <% else %>
    <p class="empty-state">No confirmed attendees yet.</p>
  <% end %>
</section>

<section class="card attendees-section">
  <h2>Waitlist <span class="count"><%= @waitlisted_enrollments.size %></span></h2>

  <% if @waitlisted_enrollments.any? %>
    <ol class="attendee-list waitlist">
      <% @waitlisted_enrollments.each_with_index do |enrollment, index| %>
        <%= render "enrollments/enrollment", event: @event, enrollment: enrollment, waitlist_position: index + 1 %>
      <% end %>
    </ol>
  <% else %>
    <p class="empty-state">No one on the waitlist.</p>
  <% end %>
</section>

<section class="card attendees-section">
  <h3><%= @event.full? ? "Join waitlist" : "Add attendee" %></h3>
  <%= render "attendees/form", event: @event, attendee: @attendee %>
</section>

<p class="back-link"><%= link_to "← All events", events_path %></p>
